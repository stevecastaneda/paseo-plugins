{
  "name": "@stevecastaneda/paseo-progress",
  "version": "1.14.7",
  "description": "A live progress dashboard per worktree for Paseo, drawn from a file agents write with the Progress tools or the paseo-progress command.",
  "keywords": [
    "coding-agents",
    "dashboard",
    "paseo",
    "paseo-plugin",
    "progress"
  ],
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/progress#readme",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "progress"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "dist/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "images/",
    "icon.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*/*.test.ts\"",
    "dev": "node ../scripts/dev.mjs",
    "check:install": "node ../scripts/check-install.mjs",
    "check:windows": "node scripts/windows-check.mjs",
    "build:cli": "rm -rf dist && esbuild server/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/cli.js --log-level=warning",
    "prepack": "npm run build:cli",
    "postpack": "rm -rf dist",
    "security-review": "node ../scripts/security-review.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.14.0",
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  }
}
