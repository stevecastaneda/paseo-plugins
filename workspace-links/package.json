{
  "name": "@stevecastaneda/paseo-workspace-links",
  "version": "0.5.2",
  "description": "Quick access to workspace URLs from a JSON file, in Paseo.",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "workspace-links"
  },
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/workspace-links#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "links",
    "workspace"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "explorer.png",
    "popover.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*/*.test.ts\"",
    "dev": "node ../scripts/dev.mjs",
    "check:install": "node ../scripts/check-install.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.9.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@getpaseo/client": "^0.9.2"
  }
}
