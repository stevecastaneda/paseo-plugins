          {
            "name": "node:module",
            "importNames": ["createRequire", "default"],
            "message": "require() loads modules this lint can't see."
          },
          {
            "name": "module",
            "importNames": ["createRequire", "default"],
            "message": "require() loads modules this lint can't see."
          }
