      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "require",
        "message": "require() loads modules the import rule can't see."
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "process",
        "property": "binding",
        "message": "Loads Node internals this lint can't see."
      },
      {
        "object": "process",
        "property": "getBuiltinModule",
        "message": "Loads node:fs or node:child_process past the import rule. Use this plugin's server/system.ts."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "shell-yeah/shared/keys.ts",
        "shell-yeah/server/claude.ts",
        "shell-yeah/server/screen.ts",
        "playwright-pulse/server/attachments.ts",
        "progress/shared/markdown.ts"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": ["*/index.client.tsx", "*/client/**", "*/shared/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off",
        "no-restricted-properties": [
          "error",
          {
            "property": "toSorted",
            "message": "Hermes, which runs Paseo on phones, has no Array#toSorted. Copy the array, then sort it."
          },
          {
            "property": "toReversed",
            "message": "Not every Hermes build Paseo ships on has Array#toReversed. Copy the array, then reverse it."
          },
          {
            "object": "process",
            "property": "binding",
            "message": "Loads Node internals this lint can't see."
          },
          {
            "object": "process",
            "property": "getBuiltinModule",
            "message": "Loads node:fs or node:child_process past the import rule. Use this plugin's server/system.ts."
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "*/server/system.ts",
        "shell-yeah/server/proc.ts",
        "playwright-pulse/server/pulse-reporter.mjs",
        "scripts/**",
        "*/scripts/**",
        "test-support/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
