              "writeFileSync",
              "writeSync",
              "writev",
              "writevSync"
            ],
            "message": "Change files through this plugin's server/system.ts, which keeps each change inside a folder the caller names and off links."
          },
          {
            "name": "fs",
            "importNames": [
              "appendFile",
              "appendFileSync",
              "chmod",
              "chmodSync",
