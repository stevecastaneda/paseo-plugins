{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_pty"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "node:child_process",
            "message": "Start programs through this plugin's server/system.ts, which runs them from a folder the repo can't control."
          },
          {
            "name": "child_process",
            "message": "Start programs through this plugin's server/system.ts, which runs them from a folder the repo can't control."
          },
          {
            "name": "node:fs",
            "importNames": [
              "appendFile",
              "appendFileSync",
              "chmod",
              "chmodSync",
              "chown",
              "chownSync",
              "copyFile",
              "copyFileSync",
              "cp",
