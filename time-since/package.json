{
  "name": "@stevecastaneda/paseo-time-since",
  "version": "1.1.0",
  "description": "Elapsed time since the last chat message, shown above the Paseo composer.",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "time-since"
  },
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/time-since#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "timer",
    "composer"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "images/",
    "icon.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*/*.test.ts\"",
    "dev": "node ../scripts/dev.mjs",
    "check:install": "node ../scripts/check-install.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
