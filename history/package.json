{
  "name": "@stevecastaneda/paseo-history",
  "version": "1.2.1",
  "description": "Inspect chat messages, tools, and raw session records from a composer pill in Paseo.",
  "keywords": [
    "history",
    "paseo",
    "paseo-plugin",
    "transcript"
  ],
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/history#readme",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "history"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "images/",
    "icon.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*/*.test.ts\"",
    "dev": "node ../scripts/dev.mjs",
    "check:install": "node ../scripts/check-install.mjs",
    "security-review": "node ../scripts/security-review.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  }
}
