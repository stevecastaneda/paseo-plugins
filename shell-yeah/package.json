{
  "name": "@stevecastaneda/paseo-shell-yeah",
  "version": "1.3.1",
  "description": "Type /sh and a command to run it as you, in the agent's folder, with live output in the chat. The agent sees it only if you send it.",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "shell-yeah"
  },
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/shell-yeah#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "shell",
    "terminal",
    "command"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "images/",
    "icon.png",
    "tsconfig.json",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"*/*.test.ts\" \"*.test.ts\"",
    "dev": "node ../scripts/dev.mjs",
    "check:install": "node ../scripts/check-install.mjs"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.0",
    "@getpaseo/plugin": "0.13.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "node-pty": "1.2.0-beta.15",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
