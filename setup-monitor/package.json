{
  "name": "@stevecastaneda/paseo-setup-monitor",
  "version": "0.4.4",
  "description": "Live worktree setup progress and logs from a button in the Paseo top bar.",
  "license": "MIT",
  "author": "Steve Castaneda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevecastaneda/paseo-plugins.git",
    "directory": "setup-monitor"
  },
  "homepage": "https://github.com/stevecastaneda/paseo-plugins/tree/main/setup-monitor#readme",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "setup",
    "worktree"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "tsconfig.json",
